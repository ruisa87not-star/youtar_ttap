{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "plugins": [
    "typescript",
    "react"
  ],
  "ignorePatterns": [
    "node_modules/**",
    "out/**",
    "dist-web/**",
    "release/**",
    "test-results*/**",
    "playwright-report/**",
    "coverage/**",
    "logs/**"
  ]
}
