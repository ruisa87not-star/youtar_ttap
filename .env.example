# Public configuration only. No UTAR credentials, CAPTCHA answers or TLS keys.
# Planner and proxy must use different HTTPS hostnames under the same site.
PLANNER_ORIGIN=https://planner.example.com
PROXY_PUBLIC_ORIGIN=https://registration.example.com
VITE_REGISTRATION_PROXY_ORIGIN=https://registration.example.com
PROXY_BIND_HOST=127.0.0.1
PROXY_PORT=3000
# Native host Caddy peer. For Docker, replace with the VERIFIED container peer IP.
PROXY_TRUSTED_IP=127.0.0.1
# Used only by the Caddy example, without scheme or path.
REGISTRATION_HOST=registration.example.com
